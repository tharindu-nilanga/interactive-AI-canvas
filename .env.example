# CANVAS proxy config — copy to .env and fill in
# .env is gitignored; never commit the key.

# Roar AI is OpenAI-compatible: base https://api.roar-ai.com/v1
ROAR_ENDPOINT=https://api.roar-ai.com/v1/chat/completions
ROAR_API_KEY=
ROAR_MODEL=gpt-4o-mini

# seconds
ROAR_TIMEOUT=45
ROAR_TEMPERATURE=0.4

# 8000 is the default; change if something else holds it
PORT=8000

# set to 1 to force the offline mock even when a key is present
MOCK=
